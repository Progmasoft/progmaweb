[Unit]
Description=Mirror the public repositories of Progmasoft from GitHub for git.progmasoft.com
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gitmirror
Group=gitmirror
ExecStart=/usr/local/libexec/git-mirror
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min

# It reads public repositories over HTTPS and writes only the mirrors.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/git/mirrors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0022
