# cgit of https://git.progmasoft.com: read-only mirrors of the public repositories of Progmasoft
# that are under development. Development happens on GitHub; git-mirror.timer fetches from there.
# Installed as /etc/cgitrc.

root-title=Progmasoft Git
root-desc=Read-only mirrors of the repositories of Progmasoft. Issues and pull requests are on GitHub.
virtual-root=/
remove-suffix=1

# The look of progmasoft.com: its stylesheet, header and footer.
css=/static/progmasoft-git.css
favicon=/static/icon.svg
logo=
head-include=/etc/cgit/progmasoft/head.html
header=/etc/cgit/progmasoft/header.html
footer=/etc/cgit/progmasoft/footer.html

# Clones go to git-http-backend (smart HTTP, upload-pack only); cgit's own dumb HTTP stays off.
enable-http-clone=0
clone-url=https://git.progmasoft.com/$CGIT_REPO_URL

# No README is rendered: without a filter cgit would include its HTML as it is.
enable-index-owner=0
enable-index-links=0
enable-blame=0
enable-commit-graph=0
enable-log-filecount=1
enable-log-linecount=0
noplainemail=1
max-stats=
snapshots=tar.gz
side-by-side-diffs=0
robots=index, nofollow

cache-root=/var/cache/cgit
cache-size=1000

