root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,slnx}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
