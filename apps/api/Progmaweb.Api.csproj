<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Progmasoft.Progmaweb.Api</RootNamespace>
    <AssemblyName>Progmaweb.Api</AssemblyName>
    <Version>1.0.0</Version>
    <!-- The XML documentation is compiled so that a broken reference or an undocumented public
         declaration fails the build; DocFX publishes the same comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Progmaweb.Api.Tests" />
  </ItemGroup>
</Project>
