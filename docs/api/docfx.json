{
  "metadata": [
    {
      "src": [
        {
          "src": "../../apps/api",
          "files": [
            "Progmaweb.Api.csproj"
          ]
        }
      ],
      "dest": "reference",
      "includePrivateMembers": true,
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "reference/**/*.yml"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Progmaweb API",
      "_enableSearch": false
    },
    "overwrite": [
      {
        "files": [
          "namespaces/*.md"
        ]
      }
    ]
  }
}
